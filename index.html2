<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PromptForge V8</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#0b1020;color:#fff}
.wrap{max-width:720px;margin:auto;padding:22px}
.card{background:#151c31;border:1px solid #2a3555;border-radius:18px;padding:20px}
h1{margin:0 0 8px;font-size:30px}.sub{color:#aeb9d5;margin-bottom:22px}
label{display:block;margin:16px 0 8px;font-weight:bold}
textarea,select{width:100%;padding:14px;border-radius:12px;border:1px solid #394767;background:#0d1426;color:#fff;font-size:16px}
textarea{min-height:150px;resize:vertical}
button{border:0;border-radius:12px;padding:13px 18px;font-weight:bold;cursor:pointer}
.primary{width:100%;margin-top:20px;background:#6d5dfc;color:#fff;font-size:17px}
.secondary{background:#273250;color:#fff;margin-top:12px}
button:disabled{opacity:.5}
#status{margin-top:16px;padding:12px;border-radius:10px;background:#0d1426;color:#cbd5ef;white-space:pre-wrap}
video{width:100%;margin-top:20px;border-radius:14px;background:#000}
.small{font-size:13px;color:#91a0c2;margin-top:12px;line-height:1.5}
</style>
</head>
<body>
<div class="wrap"><div class="card">
<h1>🎬 PromptForge V8</h1>
<div class="sub">Turn your story into a real AI-generated video.</div>

<label for="story">Your story</label>
<textarea id="story" maxlength="1500">A young African boy walks through a mysterious forest and discovers a glowing blue stone.</textarea>

<label for="duration">Video length</label>
<select id="duration">
<option value="5">5 seconds — recommended for free testing</option>
<option value="10">10 seconds</option>
<option value="15">15 seconds</option>
<option value="20">20 seconds — may exceed daily free quota</option>
</select>

<label for="ratio">Aspect ratio</label>
<select id="ratio"><option value="16:9">16:9 landscape</option><option value="9:16">9:16 portrait</option></select>

<label for="style">Style</label>
<select id="style">
<option>Cinematic realistic</option><option>Epic fantasy</option>
<option>African cinematic</option><option>Anime</option>
<option>3D animation</option><option>Documentary</option>
</select>

<button id="generate" class="primary">GENERATE VIDEO</button>
<div id="status">Ready.</div>
<video id="video" controls playsinline style="display:none"></video>
<a id="download" class="secondary" style="display:none;text-decoration:none">DOWNLOAD VIDEO</a>

<div class="small">Powered by Wan2.1 T2V 1.3B on Hugging Face ZeroGPU. Free accounts have a daily GPU quota, so longer videos may require waiting for the quota to reset.</div>
</div></div>

<script>
const HF_SPACE = "https://YOUR-HF-SPACE.hf.space";

const story=document.getElementById("story");
const duration=document.getElementById("duration");
const ratio=document.getElementById("ratio");
const style=document.getElementById("style");
const generate=document.getElementById("generate");
const statusBox=document.getElementById("status");
const video=document.getElementById("video");
const download=document.getElementById("download");

function setStatus(s){statusBox.textContent=s;}

async function generateVideo(){
  if(HF_SPACE.includes("YOUR-HF-SPACE")){
    setStatus("First create your Hugging Face PromptForge V8 Space, then replace HF_SPACE in this file with its .hf.space address.");
    return;
  }

  generate.disabled=true; video.style.display="none"; download.style.display="none";

  try{
    setStatus("Connecting to Hugging Face...\nYour request may wait in the ZeroGPU queue.");

    const submit=await fetch(HF_SPACE+"/gradio_api/call/generate",{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({data:[story.value.trim(),Number(duration.value),ratio.value,style.value]})
    });

    if(!submit.ok) throw new Error(await submit.text());
    const first=await submit.json();
    const eventId=first.event_id;
    setStatus("Video job submitted.\nWaiting for generation...");

    const stream=await fetch(HF_SPACE+"/gradio_api/call/generate/"+eventId);
    if(!stream.ok) throw new Error("Could not read generation result.");

    const reader=stream.body.getReader();
    const decoder=new TextDecoder();
    let buffer="";

    while(true){
      const {value,done}=await reader.read();
      if(done) break;
      buffer+=decoder.decode(value,{stream:true});
      const events=buffer.split("\n\n");
      buffer=events.pop();

      for(const block of events){
        const lines=block.split("\n");
        const eventLine=lines.find(x=>x.startsWith("event:"));
        const dataLine=lines.find(x=>x.startsWith("data:"));
        if(!dataLine) continue;

        const eventName=eventLine?eventLine.replace("event:","").trim():"";
        const raw=dataLine.replace("data:","").trim();

        if(eventName==="progress") setStatus("Generating video...\nPlease keep this page open.");

        if(eventName==="complete"){
          const data=JSON.parse(raw);
          const result=data&&data[0];
          let url=null;
          if(typeof result==="string") url=result;
          else if(result&&result.url) url=result.url;
          else if(result&&result.path) url=result.path;
          if(!url) throw new Error("Hugging Face returned no video URL.");
          if(url.startsWith("/")) url=HF_SPACE+url;

          video.src=url; video.style.display="block";
          download.href=url; download.download="promptforge-v8.mp4";
          download.style.display="inline-block";
          setStatus("✅ Video generated successfully.");
        }

        if(eventName==="error") throw new Error(raw);
      }
    }
  }catch(err){
    console.error(err);
    setStatus("❌ "+(err.message||"Video generation failed."));
  }finally{
    generate.disabled=false;
  }
}

generate.addEventListener("click",generateVideo);
</script>
</body>
</html>
